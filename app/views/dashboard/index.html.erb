<% content_for :header_title, "Dashboard" %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 min-w-0">
    <div class="text-sm font-medium text-gray-500 mb-1">Session Expires</div>
    <div class="text-2xl font-bold text-gray-900">
      <% if @valid_until %>
        <%= Time.parse(@valid_until).strftime("%H:%M") %>
      <% else %>
        Unknown
      <% end %>
    </div>
    <div class="text-xs text-green-600 mt-2 flex items-center">
      <span class="w-2 h-2 bg-green-500 rounded-full mr-1"></span> Active
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 min-w-0">
    <div class="text-sm font-medium text-gray-500 mb-1">Current NIP</div>
    <div class="text-2xl font-bold text-gray-900 break-all"><%= @nip %></div>
    <div class="text-xs text-gray-500 mt-2">Environment: <%= current_environment %></div>
  </div>

  <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200 min-w-0">
    <div class="text-sm font-medium text-gray-500 mb-1">Invoices</div>
    <%= link_to "Open invoice list", invoices_path, class: "text-base font-semibold text-indigo-600 hover:text-indigo-800" %>
    <div class="text-xs text-gray-500 mt-2">Fetches the latest available invoices from KSeF.</div>
  </div>
</div>
