<div class="max-w-md w-full bg-white rounded-xl shadow-lg p-8 border border-gray-100">
  <div class="text-center mb-8">
    <div class="inline-flex items-center justify-center w-12 h-12 bg-indigo-600 rounded-lg mb-4">
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
    </div>
    <h2 class="text-2xl font-bold text-gray-900">Sign in to KSeF</h2>
    <p class="text-sm text-gray-500 mt-2">Manage your e-invoices securely</p>
  </div>

  <% if flash[:alert] %>
    <div class="bg-red-50 text-red-700 p-4 rounded-lg mb-6 text-sm border border-red-200">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if @profiles.any? %>
    <div class="mb-6">
      <h3 class="text-sm font-medium text-gray-700 mb-3">Select Profile</h3>
      <div class="space-y-2">
        <% @profiles.each do |profile| %>
          <%= button_to sessions_path(profile_name: profile.name), method: :post, class: "w-full flex items-center justify-between p-4 bg-gray-50 hover:bg-indigo-50 border border-gray-200 hover:border-indigo-200 rounded-lg transition-all group group-hover:shadow-sm text-left" do %>
            <div>
              <div class="font-medium text-gray-900 group-hover:text-indigo-700"><%= profile.name %></div>
              <div class="text-xs text-gray-500 mt-0.5">ID: <%= profile.id %></div>
              <div class="text-xs text-gray-500 mt-0.5">NIP: <%= profile.nip %></div>
            </div>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          <% end %>
        <% end %>
      </div>
      
      <div class="relative flex py-6 items-center">
        <div class="flex-grow border-t border-gray-200"></div>
        <span class="flex-shrink-0 mx-4 text-gray-400 text-xs uppercase font-medium">Or enter credentials</span>
        <div class="flex-grow border-t border-gray-200"></div>
      </div>
    </div>
  <% end %>

  <%= form_with url: sessions_path, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :nip, "NIP", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :nip, class: "w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 shadow-sm" %>
    </div>

    <div>
      <%= f.label :token, "API Token", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :token, class: "w-full rounded-lg border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 shadow-sm" %>
    </div>

    <div class="pt-2">
      <%= f.submit "Sign In", class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors shadow-sm" %>
    </div>
  <% end %>
</div>
