<% content_for :header_title, "Invoices" %>

<div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
  <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between bg-white">
    <div>
        <h3 class="text-lg font-semibold text-gray-900">Registered Invoices</h3>
        <p class="text-sm text-gray-500 mt-1"><%= @filter.summary %></p>
    </div>

    <div class="flex items-center gap-3">
      <% if @invoices.any? && @filter.error.blank? %>
        <%= link_to download_csv_invoices_path(@filter.request_params.merge(format: :csv)), class: "group bg-white border border-gray-300 text-gray-700 hover:border-emerald-500 hover:text-emerald-600 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 flex items-center shadow-sm hover:shadow" do %>
          <svg class="w-4 h-4 mr-2 text-gray-400 group-hover:text-emerald-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v10m0 0l-4-4m4 4l4-4m3 6H5"></path></svg>
          Download CSV
        <% end %>
      <% else %>
        <span class="bg-gray-100 border border-gray-200 text-gray-400 px-4 py-2 rounded-lg text-sm font-medium inline-flex items-center cursor-not-allowed" aria-disabled="true">
          <svg class="w-4 h-4 mr-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v10m0 0l-4-4m4 4l4-4m3 6H5"></path></svg>
          Download CSV
        </span>
      <% end %>

      <%= link_to invoices_path(@filter.request_params), class: "group bg-white border border-gray-300 text-gray-700 hover:border-indigo-500 hover:text-indigo-600 px-4 py-2 rounded-lg text-sm font-medium transition-all duration-200 flex items-center shadow-sm hover:shadow" do %>
        <svg class="w-4 h-4 mr-2 text-gray-400 group-hover:text-indigo-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
        Refresh
      <% end %>
    </div>
  </div>

  <div class="px-6 py-5 border-b border-gray-200 bg-gray-50/70">
    <%= form_with url: invoices_path, method: :get, class: "space-y-4" do %>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wide text-gray-500 mb-2">Quick ranges</div>
        <div class="flex flex-wrap gap-2">
          <% @filter.range_options.each do |option| %>
            <% radio_id = "invoice_range_#{option[:key]}" %>
            <%= radio_button_tag :range, option[:key], @filter.active_range_key == option[:key], id: radio_id, class: "peer sr-only" %>
            <%= label_tag radio_id, option[:label], class: "rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors cursor-pointer hover:border-indigo-400 hover:text-indigo-600 peer-checked:border-indigo-600 peer-checked:bg-indigo-600 peer-checked:text-white" %>
          <% end %>

          <%= radio_button_tag :range, "custom", @filter.active_range_key == "custom", id: "invoice_range_custom", class: "peer sr-only" %>
          <%= label_tag "invoice_range_custom", "Custom range", class: "rounded-full border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition-colors cursor-pointer hover:border-indigo-400 hover:text-indigo-600 peer-checked:border-indigo-600 peer-checked:bg-indigo-600 peer-checked:text-white" %>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] items-end">
        <div>
          <label for="from_date" class="block text-sm font-medium text-gray-700 mb-1">From</label>
          <%= date_field_tag :from_date, @filter.from_value, id: "from_date", class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
        </div>

        <div>
          <label for="to_date" class="block text-sm font-medium text-gray-700 mb-1">To</label>
          <%= date_field_tag :to_date, @filter.to_value, id: "to_date", class: "w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
        </div>

        <div class="flex items-center gap-3">
          <%= submit_tag "Apply", class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm transition-colors hover:bg-indigo-700 cursor-pointer" %>
          <%= link_to "Reset", invoices_path, class: "inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition-colors hover:border-gray-400 hover:text-gray-900" %>
        </div>
      </div>

      <% if @filter.error.present? %>
        <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
          <%= @filter.error %>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead class="bg-gray-50/50 text-gray-500 font-medium border-b border-gray-100 uppercase tracking-wider text-xs">
        <tr>
          <th class="px-6 py-4">Invoice Details</th>
          <th class="px-6 py-4">Date</th>
          <th class="px-6 py-4">Subject</th>
          <th class="px-6 py-4 text-right">Amount</th>
          <th class="px-6 py-4 text-center">Type</th>
          <th class="px-6 py-4"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @invoices.any? %>
          <% @invoices.each do |invoice| %>
            <tr class="group hover:bg-gray-50/80 transition-colors">
              <td class="px-6 py-4">
                <div class="flex flex-col">
                    <span class="font-semibold text-gray-900 text-sm"><%= invoice.invoice_number || "No Number" %></span>
                    <span class="text-xs text-gray-400 font-mono mt-0.5 truncate max-w-[12rem]" title="<%= invoice.ksef_number %>"><%= invoice.ksef_number %></span>
                </div>
              </td>
              <td class="px-6 py-4">
                 <div class="flex flex-col">
                    <span class="text-gray-900"><%= invoice.issue_date %></span>
                    <span class="text-xs text-gray-500">Issued</span>
                 </div>
              </td>
              <td class="px-6 py-4">
                 <div class="flex flex-col">
                    <span class="text-gray-900 font-medium"><%= invoice.seller_name %></span>
                    <span class="text-xs text-gray-500">NIP: <%= invoice.seller_nip %></span>
                 </div>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="font-bold text-gray-900 tracking-tight">
                    <%= invoice.gross_amount %> <span class="text-gray-500 font-normal text-xs ml-0.5"><%= invoice.currency %></span>
                </div>
                <div class="text-xs text-gray-400 mt-0.5">Net: <%= invoice.net_amount %></div>
              </td>
              <td class="px-6 py-4 text-center">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 border border-indigo-100 uppercase tracking-wide">
                  <%= invoice.invoice_type %>
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <%= link_to invoice_path(invoice.ksef_number), class: "text-gray-400 hover:text-indigo-600 font-medium p-2 hover:bg-indigo-50 rounded-full transition-all inline-flex items-center justify-center group-hover:text-gray-600" do %>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="px-6 py-12 text-center">
              <div class="flex flex-col items-center justify-center">
                  <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mb-4">
                      <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                  </div>
                  <% if @filter.error.present? %>
                    <h3 class="text-gray-900 font-medium">Fix the date range</h3>
                    <p class="text-gray-500 text-sm mt-1 max-w-sm">Update the filter above and apply it again to load invoices.</p>
                  <% else %>
                    <h3 class="text-gray-900 font-medium">No invoices found</h3>
                    <p class="text-gray-500 text-sm mt-1 max-w-sm">There are no invoices for this profile in the selected range.</p>
                  <% end %>
                  
                  <%= link_to invoices_path(@filter.request_params), class: "mt-4 text-indigo-600 font-medium text-sm hover:text-indigo-800" do %>
                    Refresh List
                  <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
