<div class="p-4 border-t border-slate-800" data-controller="menu" data-action="click@window->menu#hide">
  <!-- Trigger Button (Current Profile) -->
  <button data-action="menu#toggle" class="w-full flex items-center gap-3 p-2 rounded-lg hover:bg-slate-800 transition-colors group text-left relative z-10">
    <div class="h-9 w-9 rounded-full bg-indigo-500/20 text-indigo-400 flex items-center justify-center text-xs font-bold ring-2 ring-indigo-500/20 group-hover:ring-indigo-500/50 transition-all">
      <%= (session[:ksef_profile_name] || "Guest")[0..1].upcase %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="text-sm font-medium text-white truncate"><%= session[:ksef_profile_name] || "Guest" %></div>
      <div class="text-xs text-slate-500 truncate group-hover:text-slate-400 transition-colors"><%= current_environment %></div>
    </div>
    <svg data-menu-target="icon" class="w-4 h-4 text-slate-500 group-hover:text-slate-300 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"></path></svg>
  </button>

  <!-- Drop-up Menu -->
  <!-- Safelist for JS transitions: opacity-100 scale-100 -->
  <div data-menu-target="menu" class="hidden opacity-0 scale-95 absolute bottom-20 left-4 right-4 bg-slate-800 rounded-xl shadow-xl border border-slate-700 overflow-hidden transform transition-all duration-200 origin-bottom ring-1 ring-black/5 z-20">
    <div class="px-3 py-2 text-xs font-semibold text-slate-500 uppercase tracking-wider bg-slate-900/50 border-b border-slate-700/50">
      Switch Profile
    </div>
    
    <div class="max-h-64 overflow-y-auto py-1">
      <% available_profiles.each do |profile| %>
        <% is_active = (profile.name == session[:ksef_profile_name]) %>
        <% if is_active %>
          <div class="flex items-center justify-between px-4 py-3 bg-indigo-500/10 border-l-2 border-indigo-500">
            <div class="min-w-0">
              <div class="text-sm font-medium text-white truncate"><%= profile.name %></div>
              <div class="text-xs text-indigo-300 truncate"><%= profile.nip %></div>
            </div>
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          </div>
        <% else %>
          <%= button_to sessions_path(profile_id: profile.id), method: :post, class: "w-full text-left px-4 py-3 hover:bg-slate-700/50 transition-colors flex items-center group", form_class: "w-full" do %>
            <div class="min-w-0">
              <div class="text-sm font-medium text-slate-300 group-hover:text-white truncate"><%= profile.name %></div>
              <div class="text-xs text-slate-500 group-hover:text-slate-400 truncate"><%= profile.nip %></div>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <!-- Divider -->
    <div class="border-t border-slate-700 my-1"></div>

    <!-- Logout Option -->
    <%= button_to logout_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-red-500/10 hover:text-red-300 transition-colors flex items-center gap-2" do %>
       <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
       Sign Out
    <% end %>
  </div>
</div>
